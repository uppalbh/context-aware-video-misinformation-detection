# Explicit local development store; production should use supabase.
STORE=sqlite
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=600
MAX_PENDING_JOBS=20
MEDIA_RETENTION_HOURS=24
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enable behind HTTPS in deployment.
COOKIE_SECURE=false
# Exact hosts only; empty disables URL ingestion. All redirects must also match.
VIDEO_URL_HOSTS=media.w3.org
# Defaults to DATA_DIR/corpus; operator imports permitted timestamped JSON locally.
# CORPUS_DIR=./data/corpus
SEMANTIC_PROVIDER=none
CONTEXT_MODEL=gpt-4.1-mini
# Explicit fabricated demo, no provider calls, never fallback for real uploads.
ENABLE_SYNTHETIC_DEMO=false
